---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
  src: ImageMetadata | string;
};

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  sizes,
} = Astro.props;
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} loading={loading} class={className} />
  ) : (
    <Image
      src={src}
      alt={alt}
      loading={loading}
      sizes={sizes}
      class={className}
    />
  )
}
