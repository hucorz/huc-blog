---
import katex from "katex";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  class?: string;
  mobile?: boolean;
};

const { headings, class: className = "", mobile = false } = Astro.props;

const tocHeadings = headings.filter(
  heading => heading.depth >= 2 && heading.depth <= 3
);

const escapeHtml = (value: string) =>
  value.replace(
    /[&<>"']/g,
    character =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character] ?? character
  );

const renderTocLabel = (text: string) => {
  let html = "";
  let cursor = 0;

  for (const match of text.matchAll(/\$([^$\n]+)\$/g)) {
    const index = match.index ?? 0;
    html += escapeHtml(text.slice(cursor, index));
    html += katex.renderToString(match[1], {
      displayMode: false,
      throwOnError: false,
      strict: "ignore",
    });
    cursor = index + match[0].length;
  }

  return html + escapeHtml(text.slice(cursor));
};

if (tocHeadings.length === 0) {
  return null;
}
---

{
  mobile ? (
    <details
      class:list={["toc-shell ps-4", className]}
      data-toc-root
      style="--toc-progress: 0%;"
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-2 text-xs font-medium">
        <span class="text-accent">目录</span>
        <span
          data-toc-progress-label
          class="text-xs font-normal tracking-wide text-foreground/55"
        >
          1 / {tocHeadings.length}
        </span>
      </summary>
      <nav aria-label="Table of contents" class="pb-2">
        <ol class="space-y-2 text-xs">
          {tocHeadings.map(heading => (
            <li class:list={{ "ms-4": heading.depth === 3 }}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-toc-link
                data-state="idle"
              >
                <span aria-hidden="true" class="toc-marker" />
                <span
                  class="toc-label"
                  set:html={renderTocLabel(heading.text)}
                />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <aside class:list={className}>
      <div class="sticky top-16">
        <div class="toc-shell ps-4" data-toc-root style="--toc-progress: 0%;">
          <p class="mb-3 flex items-center justify-between gap-3 text-xs font-medium">
            <span class="text-accent">目录</span>
            <span
              data-toc-progress-label
              class="text-xs font-normal tracking-wide text-foreground/55"
            >
              1 / {tocHeadings.length}
            </span>
          </p>
          <nav aria-label="Table of contents">
            <ol class="space-y-2 text-xs">
              {tocHeadings.map(heading => (
                <li class:list={{ "ms-4": heading.depth === 3 }}>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link"
                    data-toc-link
                    data-state="idle"
                  >
                    <span aria-hidden="true" class="toc-marker" />
                    <span
                      class="toc-label"
                      set:html={renderTocLabel(heading.text)}
                    />
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </div>
    </aside>
  )
}

<style>
  .toc-shell {
    position: relative;
  }

  .toc-shell::before,
  .toc-shell::after {
    content: "";
    position: absolute;
    left: 0;
    width: 2px;
    border-radius: 999px;
  }

  .toc-shell::before {
    top: 0;
    bottom: 0;
    background: var(--border);
    opacity: 0.8;
  }

  .toc-shell::after {
    top: 0;
    height: var(--toc-progress, 0%);
    background: var(--accent);
    transition: height 180ms ease;
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    color: var(--foreground);
    opacity: 0.8;
    transition:
      color 160ms ease,
      opacity 160ms ease,
      transform 160ms ease;
  }

  .toc-link:hover {
    color: var(--accent);
  }

  .toc-marker {
    margin-top: 0.4rem;
    height: 0.4rem;
    width: 0.4rem;
    flex: none;
    border-radius: 999px;
    background: var(--border);
    opacity: 0.9;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      opacity 160ms ease;
  }

  .toc-label {
    min-width: 0;
  }

  .toc-label :global(.katex) {
    font-size: 1em;
  }

  .toc-link[data-state="done"] {
    opacity: 0.72;
  }

  .toc-link[data-state="done"] .toc-marker {
    background: var(--accent);
    opacity: 0.45;
  }

  .toc-link[data-state="active"] {
    color: var(--accent);
    opacity: 1;
    transform: translateX(2px);
  }

  .toc-link[data-state="active"] .toc-marker {
    background: var(--accent);
    opacity: 1;
    transform: scale(1.35);
  }

  .toc-link[aria-current="true"] .toc-label {
    font-weight: 600;
  }
</style>

<script is:inline data-astro-rerun>
  function initPostToc() {
    window.__postTocCleanup?.();

    const article = document.getElementById("article");
    const tocRoots = Array.from(document.querySelectorAll("[data-toc-root]"));
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));

    if (!article || tocRoots.length === 0 || tocLinks.length === 0) {
      window.__postTocCleanup = undefined;
      return;
    }

    const linksById = new Map();
    for (const link of tocLinks) {
      const href = link.getAttribute("href");
      if (!href?.startsWith("#")) continue;

      const id = decodeURIComponent(href.slice(1));
      const links = linksById.get(id) ?? [];
      links.push(link);
      linksById.set(id, links);
    }

    const entries = Array.from(article.querySelectorAll("h2[id], h3[id]"))
      .map(heading => ({
        heading,
        links: linksById.get(heading.id) ?? [],
      }))
      .filter(entry => entry.links.length > 0);

    const progressLabels = Array.from(
      document.querySelectorAll("[data-toc-progress-label]")
    );

    if (entries.length === 0) {
      window.__postTocCleanup = undefined;
      return;
    }

    let ticking = false;

    const syncTocState = () => {
      ticking = false;

      const offset = Math.max(96, Math.min(window.innerHeight * 0.18, 160));
      let activeIndex =
        entries.findIndex(
          ({ heading }) => heading.getBoundingClientRect().top > offset
        ) - 1;

      if (activeIndex < 0) activeIndex = 0;
      if (activeIndex >= entries.length) activeIndex = entries.length - 1;

      const progress = ((activeIndex + 1) / entries.length) * 100;

      for (const root of tocRoots) {
        root.style.setProperty("--toc-progress", `${progress}%`);
      }

      for (const label of progressLabels) {
        label.textContent = `${activeIndex + 1} / ${entries.length}`;
      }

      entries.forEach(({ links }, index) => {
        const state =
          index < activeIndex
            ? "done"
            : index === activeIndex
              ? "active"
              : "idle";

        for (const link of links) {
          link.dataset.state = state;

          if (state === "active") {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      });
    };

    const requestSync = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(syncTocState);
    };

    requestSync();

    window.addEventListener("scroll", requestSync, { passive: true });
    window.addEventListener("resize", requestSync);
    window.addEventListener("hashchange", requestSync);

    window.__postTocCleanup = () => {
      window.removeEventListener("scroll", requestSync);
      window.removeEventListener("resize", requestSync);
      window.removeEventListener("hashchange", requestSync);
    };
  }

  initPostToc();
</script>
